+  // Render-pass-break histogram (DXVK_PASS_PROBE=<path>).
+  //
+  // On Metal every render pass is a separate MTLRenderCommandEncoder, so a frame that spills
+  // its render pass 60 times pays for 60 encoders. This records which DxvkContext operation
+  // forced each break, so the expensive ones can be found rather than guessed at.
+  class DxvkPassProbe {
+  public:
+    static DxvkPassProbe& get() {
+      static DxvkPassProbe instance;
+      return instance;
+    }
+
+    void spill(const char* why) {
+      if (m_file == nullptr)
+        return;
+      m_counts[why] += 1;
+      m_total += 1;
+      auto now = std::chrono::steady_clock::now();
+      if (std::chrono::duration<double>(now - m_tick).count() < 5.0)
+        return;
+      m_tick = now;
+      std::fprintf(m_file, "--- %llu spills total\n", (unsigned long long) m_total);
+      for (const auto& e : m_counts)
+        std::fprintf(m_file, "%8llu  %s\n", (unsigned long long) e.second, e.first.c_str());
+      std::fflush(m_file);
+    }
+
+  private:
+    DxvkPassProbe() {
+      const char* path = std::getenv("DXVK_PASS_PROBE");
+      if (path != nullptr && *path != '\0')
+        m_file = std::fopen(path, "a");
+      m_tick = std::chrono::steady_clock::now();
+    }
+
+    FILE* m_file = nullptr;
+    uint64_t m_total = 0;
+    std::map<std::string, uint64_t> m_counts;
+    std::chrono::steady_clock::time_point m_tick;
+  };
+
