+    // --attach <pid>: hook a process that is ALREADY running instead of launching one.
+    //
+    // Needed whenever the process doing the x87 work is not the one we can launch. Under wine
+    // that is the common case: the game is started by a launcher (Ashita) and runs in a child
+    // process, so wrapping the launcher patches the wrong process and changes nothing. The
+    // target must have been started with ROSETTA_DISABLE_AOT=1 in its environment, or Rosetta
+    // never calls translate_insn and there is nothing to hook.
+    pid_t attachPid = 0;
+    if (argi + 1 < argc && std::string_view(argv[argi]) == "--attach") {
+        attachPid = static_cast<pid_t>(atoi(argv[argi + 1]));
+        argi += 2;
+    }
     // Sampling profiler options; X87_SAMPLE and friends override these below.
     sidecar::SamplerConfig samplerCfg;
     while (argi < argc) {
@@ -1003,7 +1015,7 @@ int main(int argc, char* argv[]) try {
