+  // configuration can be compared with the same instrument. Off unless the env var is set.
+  struct DxvkFpsLog {
+    static constexpr size_t NumTracked = 6;
+    static constexpr DxvkStatCounter Tracked[NumTracked] = {
+      DxvkStatCounter::CmdDrawCalls,
+      DxvkStatCounter::CmdRenderPassCount,
+      DxvkStatCounter::CmdBarrierCount,
+      DxvkStatCounter::QueueSubmitCount,
+      DxvkStatCounter::CsChunkCount,
+      DxvkStatCounter::GpuIdleTicks,
+    };
+
+    FILE* file = nullptr;
+    std::chrono::steady_clock::time_point t0;
+    std::chrono::steady_clock::time_point tick;
+    uint64_t frames = 0;
+    uint64_t prev[NumTracked] = { };
+
+    DxvkFpsLog() {
+      const char* path = std::getenv("DXVK_FPS_LOG");
+      if (path == nullptr || *path == '\0')
+        return;
+      file = std::fopen(path, "a");
+      if (file == nullptr)
+        return;
+      t0 = tick = std::chrono::steady_clock::now();
+      std::fprintf(file, "epoch,elapsed,fps,draws,passes,barriers,submits,cschunks,gpuidle_us\n");
+      std::fflush(file);
+    }
+
+    void frame(const DxvkStatCounters& ctrs) {
+      if (file == nullptr)
+        return;
+      frames += 1;
+      auto now = std::chrono::steady_clock::now();
+      double dt = std::chrono::duration<double>(now - tick).count();
+      if (dt < 1.0)
+        return;
+
+      double perFrame[NumTracked];
+      for (size_t i = 0; i < NumTracked; i++) {
+        uint64_t cur = ctrs.getCtr(Tracked[i]);
+        perFrame[i] = double(cur - prev[i]) / double(frames);
+        prev[i] = cur;
+      }
+
+      std::fprintf(file, "%lld,%.1f,%.2f,%.1f,%.1f,%.1f,%.2f,%.1f,%.0f\n",
+        (long long) std::time(nullptr),
+        std::chrono::duration<double>(now - t0).count(),
+        double(frames) / dt,
+        perFrame[0], perFrame[1], perFrame[2], perFrame[3], perFrame[4], perFrame[5]);
+      std::fflush(file);
+      frames = 0;
+      tick = now;
+    }
