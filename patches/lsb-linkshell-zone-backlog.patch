+std::unordered_map<uint32, timer::time_point> DepartureTimes;
+
+// charid -> what AddOnlineMember decided this character is owed, waiting for the 0x00A handler
+// to be reached so the packets survive clearPacketList().
+struct PendingReplay
+{
+    uint32            linkshellId;
+    timer::time_point since;
+};
+std::unordered_map<uint32, PendingReplay> PendingReplays;
