+void CLinkshell::BufferMessage(uint32 senderId, const std::string& senderName, xi::ZoneId zoneId, const std::string& message, uint8 gmLevel)
+{
+    m_recent.push_back(BufferedMessage{ senderId, senderName, zoneId, message, gmLevel, timer::now() });
+
+    const auto cutoff = timer::now() - linkshell::LINKSHELL_BACKLOG_MAX_AGE;
+    while (!m_recent.empty() && (m_recent.size() > linkshell::LINKSHELL_BACKLOG_SIZE || m_recent.front().when < cutoff))
+    {
+        m_recent.pop_front();
+    }
+}
+
+void CLinkshell::ReplayMissedMessages(CCharEntity* PChar, timer::time_point since)
+{
+    if (PChar == nullptr)
+    {
+        return;
+    }
+
+    for (const auto& buffered : m_recent)
+    {
+        if (buffered.when <= since || buffered.senderId == PChar->id)
+        {
+            continue;
+        }
+
+        auto packet = std::make_unique<GP_SERV_COMMAND_CHAT_STD>(buffered.senderName, buffered.zoneId, MESSAGE_LINKSHELL, buffered.message, buffered.gmLevel);
+        if (PChar->PLinkshell2 == this)
+        {
+            packet->ref<uint8>(0x04) = MESSAGE_LINKSHELL2;
+        }
+        PChar->pushPacket(std::move(packet));
+    }
+}
