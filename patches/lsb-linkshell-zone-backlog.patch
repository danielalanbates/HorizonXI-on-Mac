+void NoteZoneDeparture(uint32 charId)
+{
+    const auto now = timer::now();
+
+    // A character that zones without a linkshell equipped never reaches the AddOnlineMember that
+    // would erase its entry, so this map would otherwise grow by one per such zone and never
+    // shrink. Anything older than the replay window is already useless; drop it. The sweep is
+    // gated on size so the common case stays O(1).
+    if (DepartureTimes.size() > 256)
+    {
+        std::erase_if(DepartureTimes, [&](const auto& entry)
+                      { return now - entry.second > LINKSHELL_BACKLOG_MAX_AGE; });
+    }
