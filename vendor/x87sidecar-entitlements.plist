<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  x87sidecar attaches to the running game process and patches Rosetta's x87 emulation, which
  needs the debugger entitlement.

  com.apple.security.get-task-allow is deliberately NOT here. It is what lets *other* processes
  attach to this one, which the sidecar does not need, and Apple's notary service rejects any
  submission containing it: "The executable requests the com.apple.security.get-task-allow
  entitlement." Keeping it made the whole app un-notarisable.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.debugger</key>
    <true/>
</dict>
</plist>
